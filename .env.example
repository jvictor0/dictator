# Backend
HOST=127.0.0.1
PORT=8000

# STT provider
STT_PROVIDER=whisper_local
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=en

# LLM provider
DICTATOR_LLM_PROVIDER=ollama
DICTATOR_OLLAMA_HOST=http://127.0.0.1:11434
DICTATOR_OLLAMA_MODEL=qwen2.5:7b-instruct
DICTATOR_OLLAMA_BIN=/opt/homebrew/bin/ollama
DICTATOR_LLM_FALLBACK=openai
# Optional runtime config path (JSON file). If unset, app resolves default path under Config/.
# DICTATOR_RUNTIME_CONFIG_PATH=apps/dictator-main/Config/runtime-config.json
# Optional OpenAI fallback (used when local provider fails and fallback=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Dictation behavior
DICTATION_TIMEOUT_SECONDS=120
